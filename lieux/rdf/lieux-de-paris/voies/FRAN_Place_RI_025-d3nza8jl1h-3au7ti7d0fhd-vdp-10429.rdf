   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nza8jl1h-3au7ti7d0fhd-vdp-10429_1855-08-11_1923-09-20">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Décret du 20 septembre 1923, côté impair, sur une longueur de 21,50 m environ avant la rue Jean de Beauvais. Décret du 16 février 1882 (UP), côté impair, entre les rues Saint-Jacques et de la Sorbonne. Décret du 30 juillet 1859, côté pair, relatif à la rue Monge, et sur une longueur de 35 m, côté impair, à partir de la rue des Bernardins. Décret du 11 août 1855 (UP), le surplus.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nza8jl1h-3au7ti7d0fhd-vdp-10429"/>
