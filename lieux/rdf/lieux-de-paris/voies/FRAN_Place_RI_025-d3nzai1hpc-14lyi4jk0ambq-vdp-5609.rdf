         </rico:Instantiation>
      </rico:hasOrHadDigitalInstantiation>
      <rico:hasOrHadDigitalInstantiation>
         <rico:Instantiation rdf:about="instantiation/FRAN_RI_025-d3nzai1hpc-14lyi4jk0ambq-vdp-5609">
            <rico:isOrWasDigitalInstantiationOf rdf:resource="record/FRAN_RI_025-d3nzai1hpc-14lyi4jk0ambq-vdp-5609"/>
            <rico:isOrWasDerivedFromInstantiation rdf:resource="instantiation/FRAN_RI_025-d3nzai1hpc-14lyi4jk0ambq-vdp-5609-src"/>
            <dc:description xml:lang="fr">Version RDF de la notice, conforme à RiC-O 1.1, résultant de l’alignement de la notice source relative à un nom de voie avec la notice relative à la voie numéro 5609 dans la nomenclature des voies de Paris publiée en open data par la mairie de Paris (jeu de données de 2023)</dc:description>
