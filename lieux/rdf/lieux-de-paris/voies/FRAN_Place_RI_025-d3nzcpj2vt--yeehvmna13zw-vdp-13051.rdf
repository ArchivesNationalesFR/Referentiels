   <rico:Place rdf:about="place/FRAN_RI_025-d3nzcpj2vt--yeehvmna13zw-vdp-13051">
      <rdfs:label xml:lang="fr">avenue du Président Wilson (8e-16e arrondissements, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">avenue du Président Wilson (8e-16e arrondissements, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">avenue du Président Wilson</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Président-Wilson (avenue du)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzcpj2vt--yeehvmna13zw-vdp-13051"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzcpj2vt--yeehvmna13zw-avenue%20du%20Pr%C3%A9sident%20Wilson"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzcpj2vt--yeehvmna13zw"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/13051_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/avenue"/>
      <rico:history xml:lang="fr">Précédemment partie de l’avenue du Trocadéro et, plus anciennement, partie de l’avenue de l’Empereur. La partie de l’avenue du Président Wilson comprise entre, d’une part, les rues de Galliera et Gaston de Saint-Paul et d’autre part les rues Brignole et de la Manutention a été dénommée place de Tokyo. | Origine du nom : Thomas Wodrow Wilson (1856-1924), président de la République des Etats-Unis.</rico:history>
