   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nzcpj2vt--yeehvmna13zw-vdp-13051_1858-03-06_1935-01-11">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Décret du 6 mars 1858. Décret du 9 mars 1897, raccordement du côté impair, avec la place de l’Alma. Décret du 23 mars 1904, raccordement du côté impair avec le côté pair de la rue des Frères Périer. L’arrêté du 11 janvier 1935 (relatif à la rue de Longchamp) a fixé une partie des alignements de l’avenue du Président Wilson au droit de l’immeuble situé à l’angle de la rue de Longchamp.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nzcpj2vt--yeehvmna13zw-vdp-13051"/>
