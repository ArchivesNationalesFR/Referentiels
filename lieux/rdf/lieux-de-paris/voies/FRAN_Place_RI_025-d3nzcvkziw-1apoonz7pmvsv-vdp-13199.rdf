   <rico:Place rdf:about="place/FRAN_RI_025-d3nzcvkziw-1apoonz7pmvsv-vdp-13199">
      <rdfs:label xml:lang="fr">place René Cassin (1er arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">place René Cassin (1er arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">place René Cassin</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">René-Cassin (place)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzcvkziw-1apoonz7pmvsv-vdp-13199"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzcvkziw-1apoonz7pmvsv-place%20Ren%C3%A9%20Cassin"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzcvkziw-1apoonz7pmvsv"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/13199_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/place"/>
      <rico:history xml:lang="fr">Place créée lors de l’aménagement du secteur des Halles. Elle avait été provisoirement dénommée W/1. | Origine du nom : René Cassin (Bayonne, 1887-Paris, 1976), juriste français, prit une part importante à la fondation de l’UNESCO et fit adopter la "Déclaration universelle des droits de l’Homme" en 1948. Prix Nobel de la Paix en 1968.</rico:history>
