   <rico:Place rdf:about="place/FRAN_RI_025-d3nzbevp4i--qwxoolka2kom-vdp-11318">
      <rdfs:label xml:lang="fr">rue de l’Hôtel de Ville (4e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue de l’Hôtel de Ville (4e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue de l’Hôtel de Ville</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Hôtel-de-Ville (rue de l’)</skos:hiddenLabel>
