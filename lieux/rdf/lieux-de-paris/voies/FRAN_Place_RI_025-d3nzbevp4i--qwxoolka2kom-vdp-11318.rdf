   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nzbevp4i--qwxoolka2kom-vdp-11318_1830-05-29_1947-08-27">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Arrêté du 27 août 1947, côté impair, entre les rues du Fauconnier et des Nonnains d’Hyères (A) et côté pair, depuis un point situé à 25 m environ de la rue du Figuier jusqu’à la rue des Nonnains d’Hyères. Arrêté du 5 mars 1945, côté pair, entre les rues des Nonnains d’Hyères et du Pont Louis Philippe (B). Ordonnance du 29 mai 1830, le surplus.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nzbevp4i--qwxoolka2kom-vdp-11318"/>
