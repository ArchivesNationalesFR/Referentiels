   <rico:Place rdf:about="place/FRAN_RI_025-d3nz969a1n--htj490p8xy83-vdp-9701">
      <rdfs:label xml:lang="fr">rue du Champ de l’Alouette (13e arrondissement, Paris, France ; id : 9701)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue du Champ de l’Alouette (13e arrondissement, Paris, France ; id : 9701)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue du Champ de l’Alouette</skos:altLabel>
