   <rico:Place rdf:about="place/FRAN_RI_025-d3nzaiv0ud--1pu63g1kpqc1p-vdp-10798">
      <rdfs:label xml:lang="fr">rue François Bonvin (15e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue François Bonvin (15e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue François Bonvin</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">François-Bonvin (rue)</skos:hiddenLabel>
