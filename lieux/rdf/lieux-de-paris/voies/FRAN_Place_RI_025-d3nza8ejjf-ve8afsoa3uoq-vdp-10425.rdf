   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nza8ejjf-ve8afsoa3uoq-vdp-10425_1836-09-27_1879-09-02">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Décret du 28 juillet 1866 (UP), sauf du côté impair, entre le n° 15 (partie) et la rue Dupuytren et, du côté pair, entre le boulevard Saint-Michel et la rue Hautefeuille et sur une longueur de 55 m à partir d’un point situé à 40 m de la rue Hautefeuille, régie par l’ordonnance du 27 septembre 1836. Décret du 2 septembre 1879 (UP), côté impair, entre le n° 15 (partie) et la rue Dupuytren.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
