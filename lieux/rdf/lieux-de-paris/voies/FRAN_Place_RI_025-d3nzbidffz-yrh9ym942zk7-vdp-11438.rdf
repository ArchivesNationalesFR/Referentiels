      <anf-onto:startingAtPoint xml:lang="fr">rue de la Bastille, 7.</anf-onto:startingAtPoint>
      <anf-onto:endingAtPoint xml:lang="fr">boulevard Beaumarchais, 13.</anf-onto:endingAtPoint>
