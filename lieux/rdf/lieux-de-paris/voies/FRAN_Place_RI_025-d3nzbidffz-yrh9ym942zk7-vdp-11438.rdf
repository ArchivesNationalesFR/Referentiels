   <rico:Place rdf:about="place/FRAN_RI_025-d3nzbidffz-yrh9ym942zk7-vdp-11438">
      <rdfs:label xml:lang="fr">rue Jean Beausire (4e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Jean Beausire (4e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue Jean Beausire</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Jean-Beausire (rue)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzbidffz-yrh9ym942zk7-vdp-11438"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzbidffz-yrh9ym942zk7-rue%20Jean%20Beausire"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzbidffz-yrh9ym942zk7"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/11438_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">Anciennement rue d’Espagne (XIVe siècle), rue du Rempart, rue Jean Boissier. Gilles Corrozet, en 1532, l’appelle déjà rue Jean Beausire. | Origine du nom : Famille de bourgeois notables dont l’un des descendants, mort en 1743, fut maître des oeuvres et contrôleur général des bâtiments de la Ville. Sans parenté avec la famille d’architectes Beausire, active à Paris au XVIIe et XVIIIe siècle.</rico:history>
