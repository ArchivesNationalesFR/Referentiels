      </rico:hasOrHadDigitalInstantiation>
      <rico:recordResourceSourceOfInformation xml:lang="fr">Notice relative à la voie 12181 dans la nomenclature des voies de Paris publiée en open data par la mairie de Paris (jeu de données de 2023)</rico:recordResourceSourceOfInformation>
      <skos:changeNote>
         <rdf:Description>
            <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dc:date>
            <rdf:value xml:lang="fr">Intégration automatique à la notice de nombreuses données relatives à ce lieu dans la nomenclature de la mairie de Paris (historique, coordonnées géographiques, données géométriques, indication des arrondissements et quartiers traversés...), ainsi que différentes activités (alignement, nivellement, numérotage...) liés à ce lieu. Ajout d’une propriété rico:type pour catégoriser le type de coordonnées (point ou polygone).</rdf:value>
         </rdf:Description>
      </skos:changeNote>
   </rico:Record>
   <rico:Place rdf:about="place/FRAN_RI_025-d3nzc0f7qu-10oleh6uaoltj-vdp-12181">
      <rdfs:label xml:lang="fr">rue des Mauvais Garçons (4e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue des Mauvais Garçons (4e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue des Mauvais Garçons</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Mauvais-Garçons (rue des)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzc0f7qu-10oleh6uaoltj-vdp-12181"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzc0f7qu-10oleh6uaoltj-rue%20des%20Mauvais%20Gar%C3%A7ons"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzc0f7qu-10oleh6uaoltj"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/12181_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">Cette voie existait au XIIIe siècle. Au XVIe siècle, on la nommait rue Chartron, dite des Mauvais Garçons. Un décret du 29 septembre 1854 avait déclaré d’utilité publique la suppression de la rue des Mauvais Garçons pour la formation des abords de la rue de Rivoli. | Origine du nom : Habitée autrefois par une population turbulente.</rico:history>
