   <rico:Place rdf:about="place/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113">
      <rdfs:label xml:lang="fr">rue de la Grange Batelière (9e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue de la Grange Batelière (9e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue de la Grange Batelière</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Grange-Batelière (rue de la)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-rue%20de%20la%20Grange%20Bateli%C3%A8re"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/11113_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">La rue de la Grange Batelière, avant 1847, commençait au boulevard Montmartre et finissait à la rue du Faubourg Montmartre ; une partie en a été détachée pour former les rues Drouot et Rossini. La partie comprise entre la rue du Faubourg Montmartre et la rue Rossini existait au XVIIe siècle sous le nom de rue Batelier. Une partie de la rue de la Grange Batelière s’appelait rue Neuve de la Grange Batelière. La partie comprise entre les rues Drouot et Chauchat, déclassée par l’arrêté du 5 février 1975, a été supprimée. Elle avait été ouverte par décret du 1er avril 1851 et ses alignements avaient été fixés par décret du 1er avril 1851. | Origine du nom : Nom d’un fief ayant existé à cet endroit.</rico:history>
      <rico:isOrWasAffectedBy rdf:resource="activity/alignement-FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113_1831-04-16_1846-12-30"/>
      <rico:isOrWasAffectedBy rdf:resource="activity/ouverture-FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113_1846-12-30"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113_longueur"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113_largeur"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113_numero_pair"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nzb9ekwn-10lwo8w4hd6hg-vdp-11113_numero_impair"/>
      <anf-onto:startingAtPoint xml:lang="fr">rue du Faubourg Montmartre, 19.</anf-onto:startingAtPoint>
      <anf-onto:endingAtPoint xml:lang="fr">rue Drouot, 12.</anf-onto:endingAtPoint>
