      <rico:recordResourceSourceOfInformation xml:lang="fr">Notice relative à la voie 209 dans la nomenclature des voies de Paris publiée en open data par la mairie de Paris (jeu de données de 2023)</rico:recordResourceSourceOfInformation>
      <skos:changeNote>
         <rdf:Description>
            <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dc:date>
            <rdf:value xml:lang="fr">Intégration automatique à la notice de nombreuses données relatives à ce lieu dans la nomenclature de la mairie de Paris (historique, coordonnées géographiques, données géométriques, indication des arrondissements et quartiers traversés...), ainsi que différentes activités (alignement, nivellement, numérotage...) liés à ce lieu. Ajout d’une propriété rico:type pour catégoriser le type de coordonnées (point ou polygone).</rdf:value>
         </rdf:Description>
      </skos:changeNote>
   </rico:Record>
   <rico:Place rdf:about="place/FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8-vdp-209">
      <rdfs:label xml:lang="fr">carrefour de la Croix Rouge (6e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">carrefour de la Croix Rouge (6e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">carrefour de la Croix Rouge</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Croix-Rouge (carrefour de la)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8-vdp-209"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8-carrefour%20de%20la%20Croix%20Rouge"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8"/>
      <anf-onto:streetStatus xml:lang="fr">voie caduque d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/209_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/carrefour"/>
      <rico:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-11-14</rico:endDate>
      <rico:history xml:lang="fr">Dénommée place Michel Debré par arrêté municipal du 14 novembre 2005. Existait au Xve siècle. Elle a reçu les dénominations de : carrefour de la Maladrerie, carrefour de la Croix Rouge, carrefour du Four, carrefour du Bonnet Rouge (en 1793), carrefour du Jeu de Boule. | Origine du nom : Une croix rouge s’y élevait autrefois.</rico:history>
      <rico:isOrWasAffectedBy rdf:resource="activity/alignement-FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8-vdp-209_1845-06-04_1872-07-05"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8-vdp-209_numero_impair"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nz9q3eyr--9ddvbew30ib8-vdp-209_numero_pair"/>
      <anf-onto:startingAtPoint xml:lang="fr">au débouché des rues du Four, de Grenelle, de Sèvres, du Cherche-Midi et du Vieux Colombier.</anf-onto:startingAtPoint>
      <anf-onto:crossesOrCrossed rdf:resource="place/FRAN_RI_023-d3nyvghr9p-1gfjh3h1l4ryc"/>
      <anf-onto:crossesOrCrossed rdf:resource="place/FRAN_RI_023-d3nyvgthrl--hvyqbcsiyfvj"/>
      <rico:isOrWasContainedBy rdf:resource="place/FRAN_RI_022-d3nyv8hmbw--1i2tdb4h5dd1p"/>
   </rico:Place>
