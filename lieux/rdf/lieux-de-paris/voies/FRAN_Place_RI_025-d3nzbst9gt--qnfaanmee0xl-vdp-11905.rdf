   <rico:Place rdf:about="place/FRAN_RI_025-d3nzbst9gt--qnfaanmee0xl-vdp-11905">
      <rdfs:label xml:lang="fr">rue Louis Blanc (10e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Louis Blanc (10e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue Louis Blanc</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Louis-Blanc (rue)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzbst9gt--qnfaanmee0xl-vdp-11905"/>
