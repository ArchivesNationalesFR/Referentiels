   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508_1824-04-21_1949-01-25">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Ordonnance du 24 janvier 1834 (UP), au droit des nos 1 à 9 et côté pair sur une longueur de 76 m environ à partir d’un point situé au droit du n° 2 à 2,20 m de la rue des Martyrs. Arrêté du 25 janvier 1949 (relatif à la rue Saint-Georges), côté impair, entre le n° 23 (exclu) et cette dernière voie. Ordonnance du 21 avril 1824, le surplus jusqu’à la rue de La Rochefoucauld, sauf du côté pair, sur une longueur de 2,20 m à partir de la rue des Martyrs. Ordonnance du 2 février 1826, partie A.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508"/>
      <rico:hadSubevent rdf:resource="activity/alignement-FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508_1824-04-21_1949-01-25_1824-04-21"/>
      <rico:hadSubevent rdf:resource="activity/alignement-FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508_1824-04-21_1949-01-25_1826-02-02"/>
      <rico:hadSubevent rdf:resource="activity/alignement-FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508_1824-04-21_1949-01-25_1834-01-24"/>
      <rico:hadSubevent rdf:resource="activity/alignement-FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508_1824-04-21_1949-01-25_1949-01-25"/>
   </rico:Activity>
   <rico:Activity rdf:about="activity/ouverture-FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508_1824-04-21_1834-01-24">
      <rico:generalDescription xml:lang="fr">Ordonnance du 24 janvier 1834 (UP), sur une longueur de 78 m environ à partir de la rue Saint-Lazare. Ordonnance du 21 avril 1824, le surplus jusqu’à la rue de La Rochefoucauld. Ordonnance du 2 février 1826, entre les rues de La Rochefoucauld et Pigalle (A).</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/ouverture%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nzc9rscf--xdbenjwzf9zi-vdp-12508"/>
