   <rico:Place rdf:about="place/FRAN_RI_025-d3nzcym3ny--pp239kd1bgz8-vdp-13330">
      <rdfs:label xml:lang="fr">rue Rouget de l’Isle (1er arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Rouget de l’Isle (1er arrondissement, Paris, France)</skos:prefLabel>
