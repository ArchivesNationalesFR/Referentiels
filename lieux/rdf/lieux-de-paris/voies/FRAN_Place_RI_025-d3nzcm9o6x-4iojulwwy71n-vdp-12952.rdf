   <rico:Place rdf:about="place/FRAN_RI_025-d3nzcm9o6x-4iojulwwy71n-vdp-12952">
      <rdfs:label xml:lang="fr">rue du Pont Neuf (1er arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue du Pont Neuf (1er arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue du Pont Neuf</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Pont-Neuf (rue du)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzcm9o6x-4iojulwwy71n-vdp-12952"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzcm9o6x-4iojulwwy71n-rue%20du%20Pont%20Neuf"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzcm9o6x-4iojulwwy71n"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/12952_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">L’ouverture de cette voie, a supprimé les rues Estienne, Tirechappe, de la Tonnellerie et la place des Trois Maries. En 1877, la partie qui était comprise entre les rues Berger et Rambuteau a pris le nom de rue Baltard. En 1962, le débouché des rues du Pont Neuf et des Halles, sur la rue Berger, a pris le nom de place Maurice Quentin. | Origine du nom : Aboutit au pont Neuf.</rico:history>
