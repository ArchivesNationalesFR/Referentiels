      <anf-onto:startingAtPoint xml:lang="fr">rue Saint-André des Arts, 41.</anf-onto:startingAtPoint>
      <anf-onto:endingAtPoint xml:lang="fr">rue Danton, 10, et boulevard Saint-Germain, 120.</anf-onto:endingAtPoint>
