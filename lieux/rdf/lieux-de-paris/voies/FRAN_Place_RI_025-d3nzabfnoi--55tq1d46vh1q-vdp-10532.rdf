   <rico:Place rdf:about="place/FRAN_RI_025-d3nzabfnoi--55tq1d46vh1q-vdp-10532">
      <rdfs:label xml:lang="fr">rue de l’Éperon (6e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue de l’Éperon (6e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue de l’Éperon</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Eperon (rue de l’)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzabfnoi--55tq1d46vh1q-vdp-10532"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzabfnoi--55tq1d46vh1q-rue%20de%20l%27%C3%89peron"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzabfnoi--55tq1d46vh1q"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/10532_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">Elle existait probablement au commencement du XIIIe siècle. En 1267, vicus Galgani ; en 1294, voie Gaugai ; en 1296, rue Gaugain ; en 1300, Cauvain ; en 1521, Gougaud ; en 1531, Gayain ; en 1543, Goyani. On la trouve appelée encore rue du Chapperon (1430), rue du Chappeau (1485), rue Chapon (1521), rue Chappon. Corrozet la nomme rue de l’Eperon. | Origine du nom : Ancienne enseigne.</rico:history>
      <rico:isOrWasAffectedBy rdf:resource="activity/alignement-FRAN_RI_025-d3nzabfnoi--55tq1d46vh1q-vdp-10532_1844-08-11"/>
