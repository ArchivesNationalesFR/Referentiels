      <rico:recordResourceSourceOfInformation xml:lang="fr">Notice relative à la voie 13889 dans la nomenclature des voies de Paris publiée en open data par la mairie de Paris (jeu de données de 2023)</rico:recordResourceSourceOfInformation>
      <skos:changeNote>
         <rdf:Description>
            <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dc:date>
            <rdf:value xml:lang="fr">Intégration automatique à la notice de nombreuses données relatives à ce lieu dans la nomenclature de la mairie de Paris (historique, coordonnées géographiques, données géométriques, indication des arrondissements et quartiers traversés...), ainsi que différentes activités (alignement, nivellement, numérotage...) liés à ce lieu. Ajout d’une propriété rico:type pour catégoriser le type de coordonnées (point ou polygone).</rdf:value>
         </rdf:Description>
      </skos:changeNote>
   </rico:Record>
   <rico:Place rdf:about="place/FRAN_RI_025-d3nzdkp6io--bn6gltk8401b-vdp-13889">
      <rdfs:label xml:lang="fr">rue des Trois Portes (5e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue des Trois Portes (5e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue des Trois Portes</skos:altLabel>
