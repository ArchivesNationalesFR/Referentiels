   <rico:Place rdf:about="place/FRAN_RI_025-d3nzc6k81o-v9darsrhzgn5-vdp-12431">
      <rdfs:label xml:lang="fr">place Napoléon III (10e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">place Napoléon III (10e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">place Napoléon III</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Napoléon-III (place)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzc6k81o-v9darsrhzgn5-vdp-12431"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzc6k81o-v9darsrhzgn5-place%20Napol%C3%A9on%20III"/>
