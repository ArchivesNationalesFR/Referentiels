      <rico:isOrWasAffectedBy rdf:resource="activity/denomination-FRAN_RI_025-d3nzc6k81o-v9darsrhzgn5_1987-01-09"/>
      <rico:hasExtent rdf:resource="extent/FRAN_RI_025-d3nzc6k81o-v9darsrhzgn5-vdp-12431_numero_impair"/>
      <anf-onto:startingAtPoint xml:lang="fr">au droit de la gare du Nord, et partie de la rue de Dunkerque.</anf-onto:startingAtPoint>
