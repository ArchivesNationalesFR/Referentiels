   <rico:Place rdf:about="place/FRAN_RI_025-d3nzadaqdm--wu4wm7an476s-vdp-10611">
      <rdfs:label xml:lang="fr">rue Eugène Varlin (10e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Eugène Varlin (10e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue Eugène Varlin</skos:altLabel>
