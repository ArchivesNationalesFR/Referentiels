   <rico:Place rdf:about="place/FRAN_RI_025-d3nzdpas15-1f2hg56m6e0c9-vdp-14040">
      <rdfs:label xml:lang="fr">place Victor Hugo (16e arrondissement, Paris, France ; id : 14040)</rdfs:label>
      <skos:prefLabel xml:lang="fr">place Victor Hugo (16e arrondissement, Paris, France ; id : 14040)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">place Victor Hugo</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Victor-Hugo (place)</skos:hiddenLabel>
