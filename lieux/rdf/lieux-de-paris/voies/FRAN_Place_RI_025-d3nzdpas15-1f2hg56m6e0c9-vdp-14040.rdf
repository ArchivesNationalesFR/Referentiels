      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/14040_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/place"/>
      <rico:history xml:lang="fr">Précédemment place d’Eylau (arr. du 19 août 1864) ; antérieurement, rond-point de la Plaine. | Origine du nom : Marie Victor Hugo (1802-1885), poète et homme politique français. Voisinage de l’avenue Victor Hugo.</rico:history>
