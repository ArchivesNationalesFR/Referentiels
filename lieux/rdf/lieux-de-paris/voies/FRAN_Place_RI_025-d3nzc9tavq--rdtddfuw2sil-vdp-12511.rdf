   <rico:Place rdf:about="place/FRAN_RI_025-d3nzc9tavq--rdtddfuw2sil-vdp-12511">
      <rdfs:label xml:lang="fr">rue Notre-Dame des Champs (6e arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Notre-Dame des Champs (6e arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue Notre-Dame des Champs</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Notre-Dame-des-Champs (rue)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzc9tavq--rdtddfuw2sil-vdp-12511"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzc9tavq--rdtddfuw2sil-rue%20Notre-Dame%20des%20Champs"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzc9tavq--rdtddfuw2sil"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/12511_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">Elle existait au XIVe siècle. Elle a été appelée chemin Herbu, rue du Barc, chemin de Coupe Gorge (1670), rue Neuve Notre-Dame des Champs et, sous la Révolution, rue de la Montagne des Champs. | Origine du nom : Ancien chemin de la chapelle de Notre-Dame des Champs.</rico:history>
