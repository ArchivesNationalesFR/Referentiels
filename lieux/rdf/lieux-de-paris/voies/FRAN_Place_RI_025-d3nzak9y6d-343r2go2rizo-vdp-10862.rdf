   <rico:Place rdf:about="place/FRAN_RI_025-d3nzak9y6d-343r2go2rizo-vdp-10862">
      <rdfs:label xml:lang="fr">rue Gabriel Lamé (12e arrondissement, Paris, France ; id : 10862)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Gabriel Lamé (12e arrondissement, Paris, France ; id : 10862)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue Gabriel Lamé</skos:altLabel>
