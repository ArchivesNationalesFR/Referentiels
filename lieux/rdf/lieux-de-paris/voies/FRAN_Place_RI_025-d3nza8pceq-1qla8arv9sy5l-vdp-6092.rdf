            <rico:isOrWasDigitalInstantiationOf rdf:resource="record/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092"/>
            <dc:description xml:lang="fr">Notice source (dans un format XML faiblement structuré, et non accessible en ligne) dans le référentiel des voies de Paris (FRAN_RI_025) du SIA des Archives nationales de France (AnF). Cette notice source concerne en fait un nom de voie, commun à plusieurs voies parisiennes.</dc:description>
            <dc:format>text/xml</dc:format>
            <rico:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FRAN_RI_025.xml#d3nza8pceq-1qla8arv9sy5l</rico:identifier>
            <rico:hasOrHadHolder rdf:resource="agent/005061"/>
            <rico:hasOrHadDerivedInstantiation rdf:resource="instantiation/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092"/>
         </rico:Instantiation>
      </rico:hasOrHadDigitalInstantiation>
      <rico:hasOrHadDigitalInstantiation>
         <rico:Instantiation rdf:about="instantiation/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092">
            <rico:isOrWasDigitalInstantiationOf rdf:resource="record/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092"/>
            <rico:isOrWasDerivedFromInstantiation rdf:resource="instantiation/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092-src"/>
            <dc:description xml:lang="fr">Version RDF de la notice, conforme à RiC-O 1.1, résultant de l’alignement de la notice source relative à un nom de voie avec la notice relative à la voie numéro 6092 dans la nomenclature des voies de Paris publiée en open data par la mairie de Paris (jeu de données de 2023)</dc:description>
