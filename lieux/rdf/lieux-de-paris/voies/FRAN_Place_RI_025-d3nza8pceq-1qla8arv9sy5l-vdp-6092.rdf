   <rico:Place rdf:about="place/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092">
      <rdfs:label xml:lang="fr">rue des Écrivains (Paris, France ; id : 6092)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue des Écrivains (Paris, France ; id : 6092)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue des Écrivains</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Ecrivains (rue des)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-rue%20des%20%C3%89crivains"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l"/>
      <anf-onto:streetStatus xml:lang="fr">voie caduque d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/6092_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">Supprimée pour l’achèvement des abords de la rue de Rivoli. Elle commençait rue Saint-Martin et finissait à la rue de la Vieille Monnaie (Supprimé.). En 1851, on avait réuni les rues Jean Pain Mollet et de la Heaumerie à la rue des Ecrivains. Au XIIIe siècle, c’était la rue Commune. Guillot, en 1300, la nomme rue Pierre o let. En 1439, rue de la Pierre au Lait, dite des Ecrivains.</rico:history>
   </rico:Place>
   <rico:Identifier rdf:about="identifier/6092_VdP">
      <rico:textualValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6092</rico:textualValue>
      <rico:type xml:lang="fr">identifiant du lieu dans la nomenclature des voies de Paris publiée en open data par la mairie de Paris (jeu de données de 2023)</rico:type>
      <rico:isOrWasIdentifierOf rdf:resource="place/FRAN_RI_025-d3nza8pceq-1qla8arv9sy5l-vdp-6092"/>
