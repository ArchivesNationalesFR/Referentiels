   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nzacna14-nb55eokjduaw-vdp-10586_1854-09-29_1929-08-19">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Décret du 29 septembre 1854 (UP), entre le boulevard de Sébastopol et la rue Saint-Denis (A). Décret du 16 janvier 1882, partie B. Décret du 13 novembre 1881, pans coupés, côté pair, aux angles de la rue Française. Arrêté du 19 août 1929, pans coupés aux angles de la rue Montorgueil, côté impair. Décret du 9 mars 1880 (UP), partie C. Décret du 12 février 1890, côté pair, raccordement avec les côtés pairs des rues Montmartre et Tiquetonne. Décret du 26 juillet 1883 (UP), partie D.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
