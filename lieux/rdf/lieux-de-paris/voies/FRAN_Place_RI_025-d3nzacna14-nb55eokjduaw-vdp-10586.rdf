   <rico:Place rdf:about="place/FRAN_RI_025-d3nzacna14-nb55eokjduaw-vdp-10586">
      <rdfs:label xml:lang="fr">rue Étienne Marcel (1er-2e arrondissements, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Étienne Marcel (1er-2e arrondissements, Paris, France)</skos:prefLabel>
