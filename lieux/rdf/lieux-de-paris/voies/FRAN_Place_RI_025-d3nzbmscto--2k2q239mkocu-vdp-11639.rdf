   <rico:Activity rdf:about="activity/numerotage-FRAN_RI_025-d3nzbmscto--2k2q239mkocu-vdp-11639_1911-02-20">
      <rico:generalDescription xml:lang="fr">Arrêté du 20 février 1911 nos 65 et 65 bis. Cet arrêté a attribué les nos 65 et 65 bis de la rue La Fayette aux immeubles qui portaient auparavant les nos 36 et 38 de la rue Bleue.</rico:generalDescription>
      <rico:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1911-02-20</rico:date>
