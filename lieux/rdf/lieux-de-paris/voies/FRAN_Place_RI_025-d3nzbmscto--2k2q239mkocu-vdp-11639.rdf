   <rico:Activity rdf:about="activity/denomination-FRAN_RI_025-d3nzbmscto--2k2q239mkocu_1849-08-28">
      <rico:generalDescription xml:lang="fr">dénomination : Décision ministérielle du 28 août 1849, réunissant la rue du Chemin de Pantin (partie D) à la rue La Fayette (partie C).</rico:generalDescription>
