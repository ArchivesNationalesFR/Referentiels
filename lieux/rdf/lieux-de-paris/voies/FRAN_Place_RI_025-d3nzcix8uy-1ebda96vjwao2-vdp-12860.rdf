   <rico:Place rdf:about="place/FRAN_RI_025-d3nzcix8uy-1ebda96vjwao2-vdp-12860">
      <rdfs:label xml:lang="fr">rue Pierre Lescot (1er arrondissement, Paris, France)</rdfs:label>
      <skos:prefLabel xml:lang="fr">rue Pierre Lescot (1er arrondissement, Paris, France)</skos:prefLabel>
      <skos:altLabel xml:lang="fr">rue Pierre Lescot</skos:altLabel>
      <skos:hiddenLabel xml:lang="fr">Pierre-Lescot (rue)</skos:hiddenLabel>
      <rico:isOrWasDescribedBy rdf:resource="record/FRAN_RI_025-d3nzcix8uy-1ebda96vjwao2-vdp-12860"/>
      <rico:hasOrHadPlaceName rdf:resource="placeName/FRAN_RI_025-d3nzcix8uy-1ebda96vjwao2-rue%20Pierre%20Lescot"/>
      <rico:thingIsTargetOfRelation rdf:resource="appellationRelation/FRAN_RI_025-d3nzcix8uy-1ebda96vjwao2"/>
      <anf-onto:streetStatus xml:lang="fr">voie actuelle d’après la nomenclature officielle des voies parisiennes en date du 31 mai 2023</anf-onto:streetStatus>
      <rico:hasOrHadIdentifier rdf:resource="identifier/12860_VdP"/>
      <rico:hasOrHadPlaceType rdf:resource="placeType/rue"/>
      <rico:history xml:lang="fr">Précédemment rue des Halles centrales entre les rues des Innocents et de la Grande Truanderie. Précédemment rue Saint-Jacques de l’Hôpital, plus anciennement rue du Cloître Saint-Jacques entre les rues de la Grande Truanderie et de Turbigo. Le tronçon compris entre les rues des Innocents et Berger, déclassé par arr. du 30 août 1972 (aménagement du secteur Forum central des Halles), a été supprimé (partie de la place Joachim du Bellay). | Origine du nom : Pierre Lescot (1510-1578), architecte français du Louvre.</rico:history>
