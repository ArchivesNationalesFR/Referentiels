   <rico:Place rdf:about="place/FRAN_RI_025-d3nzcd2ahe-da08fefsm98n-vdp-12623">
      <rdfs:label xml:lang="fr">chemin du Parc de Charonne (20e arrondissement, Paris, France ; id : 12623)</rdfs:label>
      <skos:prefLabel xml:lang="fr">chemin du Parc de Charonne (20e arrondissement, Paris, France ; id : 12623)</skos:prefLabel>
