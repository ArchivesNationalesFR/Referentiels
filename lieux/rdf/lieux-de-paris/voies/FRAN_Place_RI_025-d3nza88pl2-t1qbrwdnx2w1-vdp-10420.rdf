   <rico:Activity rdf:about="activity/ouverture-FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420_1852-12-23_1866">
      <rico:generalDescription xml:lang="fr">La partie comprise entre les rues de Rivoli et Saint-Honoré (partie A) a été ouverte sur des terrains expropriés pour la formation des abords de la rue de Rivoli (Décret du 23 décembre 1852). La partie à la suite a été ouverte vers 1866 lors de la formation des abords de la place du Théâtre Française.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/ouverture%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420"/>
      <rico:hadSubevent rdf:resource="activity/ouverture-FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420_1852-12-23_1866_1852-12-23"/>
      <rico:hadSubevent rdf:resource="activity/ouverture-FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420_1852-12-23_1866_1866"/>
   </rico:Activity>
