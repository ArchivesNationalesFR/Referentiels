   <rico:Activity rdf:about="activity/alignement-FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420_1854-05-29_1876-06-27">
      <rico:generalDescription xml:lang="fr">Non retenus au POS et non repris au PLU : Décret du 27 juin 1876, côté impair, entre la rue Saint-Honoré et l’avenue de l’Opéra. Décret du 29 mai 1854, le surplus.</rico:generalDescription>
      <rico:hasActivityType rdf:resource="activityType/alignement%20de%20voie%20urbaine"/>
      <rico:affectsOrAffected rdf:resource="place/FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420"/>
      <rico:hadSubevent rdf:resource="activity/alignement-FRAN_RI_025-d3nza88pl2-t1qbrwdnx2w1-vdp-10420_1854-05-29_1876-06-27_1854-05-29"/>
